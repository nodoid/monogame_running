<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <RootNamespace>MonsterMaze.iOS</RootNamespace>
    <AssemblyName>MonsterMaze</AssemblyName>
    <!-- Each chapter gets its own bundle id so several chapters can be installed side by side. -->
    <ApplicationId>com.monstermaze.chapter$(ChapterNumber)</ApplicationId>
    <ApplicationTitle>Monster Maze $(ChapterNumber)</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <MonoGamePlatform>iOS</MonoGamePlatform>
  </PropertyGroup>
  <ItemGroup>
    <MonoGameContentReference Include="..\MonsterMaze.Core\Content\MonsterMaze.mgcb" Link="Content\MonsterMaze.mgcb" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shaders are compiled ahead of time (see Tools/ShaderCompiler) and packaged as-is. -->
    <BundleResource Include="..\MonsterMaze.Core\Content\Effects\Compiled\iOS\*.xnb" Link="Content\Effects\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MonsterMaze.Core\MonsterMaze.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="$(MonoGameVersion)" />
    <PackageReference Include="MonoGame.Framework.iOS" Version="$(MonoGameVersion)" />
  </ItemGroup>
</Project>
