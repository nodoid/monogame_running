<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- A plain black, full-screen theme with no title bar. -->
  <style name="MainTheme" parent="@android:style/Theme.Black.NoTitleBar.Fullscreen">
    <item name="android:windowBackground">@android:color/black</item>
  </style>
  <!-- Shown while the game starts up: the Monster Maze logo on black. -->
  <style name="Theme.Splash" parent="MainTheme">
    <item name="android:windowBackground">@drawable/splash</item>
  </style>
</resources>
