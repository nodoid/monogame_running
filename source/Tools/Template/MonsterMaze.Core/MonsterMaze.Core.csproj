<Project Sdk="Microsoft.NET.Sdk">
  <!--
    All of the game lives in this platform-neutral library. It compiles against the
    MonoGame API only; each platform project supplies the real MonoGame implementation.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MonsterMaze</RootNamespace>
    <AssemblyName>MonsterMaze.Core</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Native" Version="$(MonoGameVersion)" PrivateAssets="All" />
  </ItemGroup>
  <!-- #if CH41 -->
  <ItemGroup>
    <InternalsVisibleTo Include="MonsterMaze.Tests" />
  </ItemGroup>
  <!-- #endif -->
</Project>
