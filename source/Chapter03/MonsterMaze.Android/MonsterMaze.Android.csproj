<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <RootNamespace>MonsterMaze.Android</RootNamespace>
    <AssemblyName>MonsterMaze</AssemblyName>
    <!-- Each chapter gets its own application id so several chapters can be installed side by side. -->
    <ApplicationId>com.monstermaze.chapter$(ChapterNumber)</ApplicationId>
    <ApplicationTitle>Monster Maze $(ChapterNumber)</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <MonoGamePlatform>Android</MonoGamePlatform>
  </PropertyGroup>
  <ItemGroup>
    <MonoGameContentReference Include="..\MonsterMaze.Core\Content\MonsterMaze.mgcb" Link="Content\MonsterMaze.mgcb" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MonsterMaze.Core\MonsterMaze.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="$(MonoGameVersion)" />
    <PackageReference Include="MonoGame.Framework.Android" Version="$(MonoGameVersion)" />
  </ItemGroup>
</Project>
